{
  "name": "@omninews/cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply omninews-db --local",
    "db:migrate": "wrangler d1 migrations apply omninews-db --remote",
    "test": "vitest run",
    "db:seed:local": "wrangler d1 execute omninews-db --local --file=./scripts/seed-local.sql",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "hono": "^4.6.14",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "@types/bcryptjs": "^3.0.0",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0",
    "wrangler": "^4.152.0"
  }
}
