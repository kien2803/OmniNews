{
  "name": "social-auto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OmniNews \u2014 schedule and publish articles to Facebook, Threads, Reddit and X.",
  "scripts": {
    "dev": "pnpm -F @social-auto/web dev",
    "build": "pnpm -F @social-auto/web build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "cf:dev": "pnpm -F @social-auto/cloudflare dev",
    "cf:deploy": "pnpm -F @social-auto/cloudflare deploy"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "playwright": "1.64.1",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  }
}
